# Copy to .env for local development. Do not commit real secrets.

# Google / Gemini / ADK
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview
GEMINI_TRANSLATION_MODEL=gemini-3.1-flash

# MongoDB Atlas
MONGO_URI=
MONGO_DB=lucero
MONGO_CHUNKS_COLLECTION=chunks
MONGO_FORMS_COLLECTION=forms
MONGO_VISA_BULLETINS_COLLECTION=visa_bulletins
MONGO_QUERY_LOGS_COLLECTION=query_logs

# MongoDB MCP
MDB_MCP_CONNECTION_STRING=
MONGODB_MCP_READ_ONLY=true

# Retrieval feature flags
LUCERO_USE_RANK_FUSION=true
LUCERO_USE_ATLAS_AUTOMATED_EMBEDDING=true
LUCERO_VECTOR_INDEX=vector_autoembed_index
LUCERO_FTS_INDEX=fts_index

# Fallback only if Atlas Automated Embedding is unavailable
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-large

# App
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_API_BASE_URL=http://127.0.0.1:8080
